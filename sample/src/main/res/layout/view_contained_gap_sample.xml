<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/contained_gap_xml_title" android:textSize="18sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/contained_gap_instructions" />
    <FrameLayout android:id="@+id/gap_parent_xml"
        android:layout_width="match_parent" android:layout_height="160dp"
        android:layout_marginTop="12dp" android:padding="0dp"
        android:background="@drawable/sample_color_surface">
        <!-- Deliberately physical margins: the inspector reports left/right, not start/end. -->
        <TextView android:id="@+id/gap_inner_xml"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginLeft="24dp" android:layout_marginTop="32dp"
            android:layout_marginRight="40dp" android:layout_marginBottom="48dp"
            android:gravity="center" android:text="@string/contained_gap_inner"
            android:textColor="#FF25236D" android:background="#FFE4F5E8"
            tools:ignore="RtlHardcoded" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/contained_gap_expected" />
</LinearLayout>
