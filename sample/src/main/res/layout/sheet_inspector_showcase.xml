<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/sheet_xml_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/xml_sheet_title" android:textSize="22sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/sheet_instructions" />
        <TextView android:id="@+id/sheet_xml_colors"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="12dp"
            android:background="@drawable/sample_color_surface" android:textColor="#FF25236D"
            android:text="@string/sheet_xml_colors" android:textSize="18sp"
            android:fontFamily="monospace" android:textStyle="bold|italic" android:letterSpacing="0.02" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <TextView android:id="@+id/sheet_box_a"
                android:layout_width="100dp" android:layout_height="48dp" android:padding="8dp"
                android:text="@string/sheet_box_a" android:background="#FFDDE7FF" android:textColor="#FF25236D" />
            <TextView android:id="@+id/sheet_box_b"
                android:layout_width="100dp" android:layout_height="48dp" android:padding="8dp"
                android:layout_marginStart="24dp" android:text="@string/sheet_box_b"
                android:background="#FFE4F5E8" android:textColor="#FF25236D" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/sheet_gap_hint" />
        <androidx.compose.ui.platform.ComposeView android:id="@+id/sheet_compose_island"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <include layout="@layout/view_contained_gap_sample"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
        <Button android:id="@+id/close_xml_bottom_sheet"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/showcase_close_sheet" />
    </LinearLayout>
</ScrollView>
